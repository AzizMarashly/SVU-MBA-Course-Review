# Working directories ARE committed under courses/ so a run can be resumed (see courses/README.md).
# Keep them out only when the prompt is run somewhere else in this repo.
/.review_generation_working_directory/
# archived deliverable versions: git history already has them
courses/**/_old_versions/
courses/**/archive/
# large regenerable OCR page images
courses/**/*.png
__pycache__/
# local scratch
*.bak
~$*
# versioned deliverables inside course folders: the same file is published under S<n>/<CODE>/index.html
courses/**/*_v[0-9][0-9].html
